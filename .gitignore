## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## This file is a combination of the Visual Studio and .NET Core gitignore
## templates from GitHub.

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]ealses/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Roslyn cache directories
*.osscache
*.exe
*.dll
*.pdb
*.suo

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if using NuGet repositories to store project-specific packages (not recomended)
# !**/[Pp]ackages/

# Microsoft Azure Build Output
csx/
*.cscfg
*.csdef

# Web
wwwroot/recordings/
C:\MediaRecords/

# Tool manifest
.config/dotnet-tools.json
